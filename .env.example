# Gemini API Key (Required for AI generation)
GEMINI_API_KEY="your_google_gemini_api_key_here"

# Database Connections (Postgres & Redis)
# For local development with Docker, use these default connections.
# For production or cloud, replace with your Supabase/Neon and Upstash URIs.
DATABASE_URL="postgresql://postgres:password@localhost:5432/echomind?schema=public"
REDIS_URL="redis://localhost:6379"

# TTS Provider (Optional)
ELEVENLABS_API_KEY="your_elevenlabs_api_key_here"
